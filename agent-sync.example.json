{
  "$schema": "https://raw.githubusercontent.com/ssheleg/agent-sync/main/agent-sync.schema.json",
  "backend": "outline",
  "leaseTtlSeconds": 2700,
  "renewIntervalSeconds": 300,
  "gated": true,
  "idRegisters": {
    "DEC": {
      "file": "docs/DECISIONS.md",
      "nextFreeIdPattern": "\\*\\*Next free ID:\\*\\* `DEC-(\\d{4})`"
    },
    "OQ": {
      "file": "docs/OPEN_QUESTIONS.md",
      "nextFreeIdPattern": "\\*\\*Next free ID:\\*\\* `OQ-(\\d{4})`"
    }
  },
  "guardedFiles": [
    "docs/DECISIONS.md",
    "docs/OPEN_QUESTIONS.md",
    "docs/ROADMAP.md",
    "docs/DOCMAP.md",
    "docs/evidence/retro.md"
  ],
  "claimTags": {
    "docs/ROADMAP.md": {
      "mode": "cell",
      "cell": -1,
      "held": "{prev} (claimed: {holder})"
    }
  },
  "gates": [
    "bash scripts/check-docs.sh"
  ],
  "mirror": {
    "enabled": true,
    "sources": [
      "docs/DECISIONS.md",
      "docs/ROADMAP.md"
    ]
  },
  "leaseBackend": "git",
  "integrationBranch": "main",
  "mergeLog": {
    "file": "docs/MERGES.md",
    "retentionDays": 7
  }
}
